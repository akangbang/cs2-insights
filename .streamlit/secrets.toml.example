# Copy into the Secrets box on Streamlit Community Cloud. Never commit the filled-in version. See DEPLOY.md.

DATABASE_URL = "postgresql://user:password@host/dbname?sslmode=require"
HALFTIME_HOSTED = "1"
HALFTIME_SECRET_KEY = ""

[auth]
redirect_uri = "https://getleanpeek.streamlit.app/oauth2callback"
cookie_secret = ""

[auth.google]
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
