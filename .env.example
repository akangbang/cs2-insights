# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://tracker:tracker_dev@localhost:5432/decision_tracker

# Steam Web API key and your match history authentication code (for linking match history)
STEAM_API_KEY=
STEAM_AUTH_CODE=

# Encrypts stored Steam auth codes. Create with: python -m cs2_insights.secretbox --new-key
HALFTIME_SECRET_KEY=

# Optional switches: set to 1 to turn on.
# Hosted mode: guests, Steam and Google sign-in, matches kept per account.
HALFTIME_HOSTED=
# Screenshot mode: stand-in names instead of real ones.
HALFTIME_HIDE_NAMES=
# Don't record usage events.
HALFTIME_NO_TRACKING=

# The hosted site's address, for Steam sign-in to send players back to (defaults to the Google redirect's site).
HALFTIME_PUBLIC_URL=

# Read-only Power BI login. Set by: python -m cs2_insights.analytics --powerbi-login
POWERBI_PASSWORD=
